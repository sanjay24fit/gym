# Supabase Project Credentials (Settings -> API)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Supabase Service Role Key (Required for backend payment verification on Vercel)
# Never expose this in client-side code!
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Razorpay API Credentials (https://dashboard.razorpay.com/#/app/keys)
# VITE_RAZORPAY_KEY_ID is public and used in the frontend checkout modal
VITE_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=YOUR-RAZORPAY-KEY-SECRET

# Direct Razorpay Handle / UPI Link fallback
VITE_RAZORPAY_HANDLE=sanjaysalvi2245
VITE_RAZORPAY_ME_URL=https://razorpay.me/@sanjaysalvi2245

# Local dev proxy (optional)
# VITE_SUPABASE_URL=/supabase
